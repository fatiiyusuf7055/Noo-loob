local player = game.Players.LocalPlayer
local RunService = game:GetService("RunService")

local CONFIG = {
    size      = Vector3.new(0.95, 0.9, 0.85),
    meshScale = Vector3.new(1.45, 1.35, 1.15),
    offsetL   = Vector3.new(-0.26, 0.05, -0.55),
    offsetR   = Vector3.new( 0.26, 0.05, -0.55),
    tiltL     = math.rad(-10),
    tiltR     = math.rad( 10),
    stiffness = 200,
    damping   = 18,
    maxDisp   = 0.22,
}

local boobL, boobR = nil, nil
local springPosL, springVelL = 0, 0
local springPosR, springVelR = 0, 0
local clock, walkPhase, prevVelY = 0, 0, 0

local function createBoob(char, torso, name)
    local old = char:FindFirstChild(name)
    if old then old:Destroy() end

    local boob = Instance.new("Part")
    boob.Name = name
    boob.Size = CONFIG.size
    boob.BrickColor = torso.BrickColor
    boob.Color = torso.Color
    boob.Material = torso.Material
    boob.Anchored = true
    boob.CanCollide = false
    boob.CastShadow = false
    boob.TopSurface = Enum.SurfaceType.Smooth
    boob.BottomSurface = Enum.SurfaceType.Smooth
    boob.Parent = char

    local mesh = Instance.new("SpecialMesh")
    mesh.MeshType = Enum.MeshType.Sphere
    mesh.Scale = CONFIG.meshScale
    mesh.Parent = boob

    local shirt = char:FindFirstChildOfClass("Shirt")
    if shirt and shirt.ShirtTemplate ~= "" then
        mesh.TextureId = shirt.ShirtTemplate
    end

    return boob
end

local function setupBoobs()
    local char = player.Character
    if not char then return end
    local torso = char:FindFirstChild("UpperTorso")
    if not torso then return end
    springPosL, springVelL = 0, 0
    springPosR, springVelR = 0, 0
    prevVelY = 0
    walkPhase = 0
    boobL = createBoob(char, torso, "BoobL")
    boobR = createBoob(char, torso, "BoobR")
end

RunService.Heartbeat:Connect(function(dt)
    dt = math.min(dt, 0.05)
    clock = clock + dt

    local char = player.Character
    if not char then return end
    local torso = char:FindFirstChild("UpperTorso")
    local hrp   = char:FindFirstChild("HumanoidRootPart")
    if not torso or not hrp then return end

    local vel      = hrp.AssemblyLinearVelocity
    local velY     = vel.Y
    local horizSpd = Vector3.new(vel.X, 0, vel.Z).Magnitude

    -- Impact atterrissage
    local impact = 0
    if prevVelY < -8 and velY > prevVelY + 3 then
        impact = math.clamp(math.abs(prevVelY) * 0.09, 0, 0.35)
    end
    prevVelY = velY

    -- Force motrice
    local drive = 0
    if horizSpd > 1 then
        local stepFreq = 0.4 + horizSpd * 0.07
        walkPhase = walkPhase + dt * stepFreq * math.pi * 2
        local stepAmp = math.min(horizSpd / 14, 1) * 4.0 + 0.4
        drive = math.sin(walkPhase) * stepAmp
    else
        drive = math.sin(clock * 1.1) * 0.18
    end

    if velY > 4 then
        drive = drive - math.min(velY * 0.05, 0.18)
    elseif velY < -4 then
        drive = drive + math.min(math.abs(velY) * 0.035, 0.15)
    end

    -- Ressort gauche
    local fL = -CONFIG.stiffness * springPosL - CONFIG.damping * springVelL + drive + impact
    springVelL = springVelL + fL * dt
    springPosL = math.clamp(springPosL + springVelL * dt, -CONFIG.maxDisp, CONFIG.maxDisp)

    -- Ressort droit (légèrement déphasé)
    local fR = -CONFIG.stiffness * springPosR - CONFIG.damping * springVelR + drive * 0.93 + impact * 0.97
    springVelR = springVelR + fR * dt
    springPosR = math.clamp(springPosR + springVelR * dt, -CONFIG.maxDisp, CONFIG.maxDisp)

    if boobL and boobL.Parent then
        boobL.CFrame = torso.CFrame
            * CFrame.new(CONFIG.offsetL + Vector3.new(0, springPosL, 0))
            * CFrame.Angles(0, 0, CONFIG.tiltL)
    end
    if boobR and boobR.Parent then
        boobR.CFrame = torso.CFrame
            * CFrame.new(CONFIG.offsetR + Vector3.new(0, springPosR, 0))
            * CFrame.Angles(0, 0, CONFIG.tiltR)
    end
end)

player.CharacterAdded:Connect(function()
    boobL, boobR = nil, nil
    task.wait(1)
    setupBoobs()
end)

task.wait(1)
setupBoobs()
