local player = game.Players.LocalPlayer
local char = player.Character or player.CharacterAdded:Wait()
task.wait(3)
local torso = char:WaitForChild("UpperTorso", 10)
if not torso then return end

local shirt = char:FindFirstChildOfClass("Shirt")

local L = Instance.new("Part")
L.Size = Vector3.new(0.95, 0.9, 0.85)
L.BrickColor = torso.BrickColor
L.Color = torso.Color
L.Material = torso.Material
L.Anchored = true
L.CanCollide = false
L.CastShadow = false
L.Parent = workspace
local mL = Instance.new("SpecialMesh")
mL.MeshType = Enum.MeshType.Sphere
mL.Scale = Vector3.new(1.45, 1.35, 1.15)
mL.Parent = L
if shirt then mL.TextureId = shirt.ShirtTemplate end

local R = Instance.new("Part")
R.Size = Vector3.new(0.95, 0.9, 0.85)
R.BrickColor = torso.BrickColor
R.Color = torso.Color
R.Material = torso.Material
R.Anchored = true
R.CanCollide = false
R.CastShadow = false
R.Parent = workspace
local mR = Instance.new("SpecialMesh")
mR.MeshType = Enum.MeshType.Sphere
mR.Scale = Vector3.new(1.45, 1.35, 1.15)
mR.Parent = R
if shirt then mR.TextureId = shirt.ShirtTemplate end

local t = 0
while torso and torso.Parent do
    t = t + 0.016
    L.CFrame = torso.CFrame * CFrame.new(-0.26, 0.05 + math.sin(t*9)*0.06, -0.58) * CFrame.Angles(0,0,math.rad(-10))
    R.CFrame = torso.CFrame * CFrame.new( 0.26, 0.05 + math.sin(t*9+1)*0.06, -0.58) * CFrame.Angles(0,0,math.rad(10))
    task.wait()
end
L:Destroy()
R:Destroy()
