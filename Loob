local player = game.Players.LocalPlayer

local char = player.Character or player.CharacterAdded:Wait()
task.wait(1)

local torso = char:FindFirstChild("UpperTorso")
if not torso then return end

local L = Instance.new("Part")
L.Size = Vector3.new(0.95, 0.9, 0.85)
L.BrickColor = torso.BrickColor
L.Color = torso.Color
L.Material = torso.Material
L.Anchored = true
L.CanCollide = false
L.CFrame = torso.CFrame * CFrame.new(-0.26, 0.05, -0.55)
L.Parent = char
local mL = Instance.new("SpecialMesh")
mL.MeshType = Enum.MeshType.Sphere
mL.Scale = Vector3.new(1.45, 1.35, 1.15)
mL.Parent = L

local R = Instance.new("Part")
R.Size = Vector3.new(0.95, 0.9, 0.85)
R.BrickColor = torso.BrickColor
R.Color = torso.Color
R.Material = torso.Material
R.Anchored = true
R.CanCollide = false
R.CFrame = torso.CFrame * CFrame.new(0.26, 0.05, -0.55)
R.Parent = char
local mR = Instance.new("SpecialMesh")
mR.MeshType = Enum.MeshType.Sphere
mR.Scale = Vector3.new(1.45, 1.35, 1.15)
mR.Parent = R

local RunService = game:GetService("RunService")
local t = 0
while true do
    local dt = RunService.Heartbeat:Wait()
    t = t + dt
    if L.Parent and R.Parent and torso.Parent then
        L.CFrame = torso.CFrame
            * CFrame.new(-0.26, 0.05 + math.sin(t * 9) * 0.06, -0.55)
            * CFrame.Angles(0, 0, math.rad(-10))
        R.CFrame = torso.CFrame
            * CFrame.new(0.26, 0.05 + math.sin(t * 9 + 1) * 0.06, -0.55)
            * CFrame.Angles(0, 0, math.rad(10))
    end
end
