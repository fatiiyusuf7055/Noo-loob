local player = game.Players.LocalPlayer
local RunService = game:GetService("RunService")

local CONFIG = {
    size         = Vector3.new(1.6, 1.5, 1.4),
    meshScale    = Vector3.new(2.0, 1.85, 1.55),
    offsetL      = Vector3.new(-0.35, 0.0, -0.68),
    offsetR      = Vector3.new( 0.35, 0.0, -0.68),
    tiltL        = math.rad(-10),
    tiltR        = math.rad( 10),
    bounceSpeed  = 9,
    bounceIdle   = 0.03,
    bounceWalk   = 0.09,
    bounceRun    = 0.18,
    speedWalk    = 8,
    speedRun     = 16,
}

local boobL, boobR = nil, nil
local clock = 0

local function createBoob(char, torso, name)
    local old = char:FindFirstChild(name)
    if old then old:Destroy() end

    local boob = Instance.new("Part")
    boob.Name = name
    boob.Size = CONFIG.size
    boob.BrickColor = torso.BrickColor
    boob.Color = torso.Color
    boob.Material = torso.Material
    boob.Anchored = true
    boob.CanCollide = false
    boob.CastShadow = false
    boob.TopSurface = Enum.SurfaceType.Smooth
    boob.BottomSurface = Enum.SurfaceType.Smooth
    boob.Parent = char

    local mesh = Instance.new("SpecialMesh")
    mesh.MeshType = Enum.MeshType.Sphere
    mesh.Scale = CONFIG.meshScale
    mesh.Parent = boob

    for _, decal in ipairs(torso:GetChildren()) do
        if decal:IsA("Decal") then
            decal:Clone().Parent = boob
        end
    end

    local shirt = char:FindFirstChildOfClass("Shirt")
    if shirt and shirt.ShirtTemplate ~= "" then
        local d = Instance.new("Decal")
        d.Texture = shirt.ShirtTemplate
        d.Face = Enum.NormalId.Front
        d.Parent = boob
    end

    local sa = torso:FindFirstChildOfClass("SurfaceAppearance")
    if sa then sa:Clone().Parent = boob end

    return boob
end

local function setupBoobs()
    local char = player.Character
    if not char then return end
    local torso = char:FindFirstChild("UpperTorso")
    if not torso then return end
    boobL = createBoob(char, torso, "BoobL")
    boobR = createBoob(char, torso, "BoobR")
end

RunService.Heartbeat:Connect(function(dt)
    clock = clock + dt

    local char = player.Character
    if not char then return end
    local torso = char:FindFirstChild("UpperTorso")
    if not torso then return end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    local speed = hrp and hrp.AssemblyLinearVelocity.Magnitude or 0

    local amplitude
    if speed < CONFIG.speedWalk then
        local t = speed / CONFIG.speedWalk
        amplitude = CONFIG.bounceIdle + (CONFIG.bounceWalk - CONFIG.bounceIdle) * t
    elseif speed < CONFIG.speedRun then
        local t = (speed - CONFIG.speedWalk) / (CONFIG.speedRun - CONFIG.speedWalk)
        amplitude = CONFIG.bounceWalk + (CONFIG.bounceRun - CONFIG.bounceWalk) * t
    else
        amplitude = CONFIG.bounceRun
    end

    local bounceL = math.sin(clock * CONFIG.bounceSpeed) * amplitude
    local bounceR = math.sin(clock * CONFIG.bounceSpeed + math.pi * 0.3) * amplitude

    if boobL and boobL.Parent then
        boobL.CFrame = torso.CFrame
            * CFrame.new(CONFIG.offsetL + Vector3.new(0, bounceL, 0))
            * CFrame.Angles(0, 0, CONFIG.tiltL)
    end
    if boobR and boobR.Parent then
        boobR.CFrame = torso.CFrame
            * CFrame.new(CONFIG.offsetR + Vector3.new(0, bounceR, 0))
            * CFrame.Angles(0, 0, CONFIG.tiltR)
    end
end)

player.CharacterAdded:Connect(function()
    boobL, boobR = nil, nil
    task.wait(1)
    setupBoobs()
end)

task.wait(1)
setupBoobs()
